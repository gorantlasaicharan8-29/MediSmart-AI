# API Base URL (empty string uses Vite dev proxy / same-origin relative URLs)
# In production on separate domain, e.g.: VITE_API_URL=https://api.medismart.example.com
VITE_API_URL=

# WebSocket Base URL (empty string auto-derives ws:// or wss:// from window.location)
# In production on separate domain, e.g.: VITE_WS_URL=wss://api.medismart.example.com
VITE_WS_URL=
