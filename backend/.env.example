# Environment mode: development | staging | production | testing
ENVIRONMENT=development

# Database configuration (PostgreSQL 18.6 local instance)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/medismart_db

# Security & Authentication
# In production, SECRET_KEY must be a strong random secret (>= 32 chars) and cannot use the development default
SECRET_KEY=dev-secret-change-in-production-random-bytes-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cookie Security (optional; automatically resolves to True in production, False in development/testing)
# COOKIE_SECURE=false

# Interactive API Documentation /docs, /redoc, /openapi.json (optional; automatically resolves to False in production, True in development)
# DOCS_ENABLED=true

# CORS settings (Frontend Vite dev server)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# WebSocket Multi-Worker Broadcast Backend: memory (single-process dev) | redis (multi-worker)
WS_BROADCAST_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0

# API prefix
API_V1_PREFIX=/api/v1


